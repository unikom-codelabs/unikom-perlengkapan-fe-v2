# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# Semua variabel yang dibaca di sisi klien (Vite) WAJIB diawali prefix VITE_.
#
# CATATAN KEAMANAN:
# - JANGAN pernah menaruh secret backend (API key, DB password, dsb) di sini.
#   Semua VITE_* ikut ter-bundle ke JavaScript dan bisa dibaca publik.
# - Ganti http:// menjadi https:// begitu backend mendukung TLS (wajib untuk production).

# Base URL endpoint API backend (tanpa trailing slash)
VITE_API_BASE_URL=http://perlengkapan.codelabspace.or.id/api

# Base URL storage/file publik backend (tanpa trailing slash)
VITE_STORAGE_BASE_URL=http://perlengkapan.codelabspace.or.id/storage
